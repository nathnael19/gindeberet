# Copy to .env on the cPanel server (Node.js App → Environment Variables, or file)
PORT=3001
NODE_ENV=production

# cPanel → MySQL® Databases — use the full username (often gindebsx_dbname)
DATABASE_URL="mysql://gindebsx_USER:PASSWORD@localhost:3306/gindebsx_DBNAME"

# Generate a long random string (never reuse the example)
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET
JWT_EXPIRE=30d

# Persistent uploads (outside deployed backend folder — survives deploy/restart)
# UPLOAD_DIR=/home/gindebsx/gindeberet_uploads

# Exact browser origin of the public site (CORS)
FRONTEND_URL=https://gindeberetconstruction.com
# FRONTEND_URLS=https://www.gindeberetconstruction.com

# One-time / Actions content fix (POST /api/setup/fix-content)
SETUP_SECRET=CHANGE_ME_LONG_RANDOM_SECRET

# Admin login + OTP inbox (Gmail with App Password)
ADMIN_EMAIL=gindeberetconstructionplc@gmail.com
ADMIN_PASSWORD=Gindeberetplc@246

# SMTP — sends contact form + forgot-password OTP (Gmail App Password, no spaces)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=gindeberetconstructionplc@gmail.com
SMTP_PASS=YOUR_16_CHAR_APP_PASSWORD_NO_SPACES
SMTP_FROM="Gindeberet Admin <gindeberetconstructionplc@gmail.com>"
# EMAIL_DEV_LOG=true

# Inbox for contact-form messages (same Gmail account)
CONTACT_TO_EMAIL=gindeberetconstructionplc@gmail.com

# Public website contact display stays gindeberetconstruction278@gmail.com (site_settings)
