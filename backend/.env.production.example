# Copy to .env on the cPanel server (Node.js App → Environment Variables, or file)
PORT=3001
NODE_ENV=production

# cPanel → MySQL® Databases — use the full username (often gindebsx_dbname)
DATABASE_URL="mysql://gindebsx_USER:PASSWORD@localhost:3306/gindebsx_DBNAME"

# Generate a long random string (never reuse the example)
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET
JWT_EXPIRE=7d

# Exact browser origin of the public site (CORS)
FRONTEND_URL=https://gindeberetconstruction.com
# FRONTEND_URLS=https://www.gindeberetconstruction.com

# One-time / Actions content fix (POST /api/setup/fix-content)
SETUP_SECRET=CHANGE_ME_LONG_RANDOM_SECRET

# Admin account applied by fix-content (optional overrides)
ADMIN_EMAIL=gindeberetconstruction278@gmail.com
ADMIN_PASSWORD=Gindeberetplc@246

# SMTP for forgot-password OTP (Gmail account)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=gindeberetconstruction278@gmail.com
SMTP_PASS=YOUR_GMAIL_APP_PASSWORD
SMTP_FROM="Gindeberet Admin <gindeberetconstruction278@gmail.com>"
# EMAIL_DEV_LOG=true

# Where public contact-form messages are delivered
CONTACT_TO_EMAIL=gindeberetconstruction278@gmail.com
