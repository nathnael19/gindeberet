# Server Configuration
PORT=3001
NODE_ENV=development

# Database Configuration
DATABASE_URL="mysql://root:password@localhost:3306/gindeberet_db"

# JWT Configuration
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRE=7d

# CORS Configuration
FRONTEND_URL=http://localhost:5173
# Optional extras (comma-separated), e.g. https://www.gindeberetconstruction.com
# FRONTEND_URLS=

# SMTP — required for admin forgot-password OTP emails
# Local dev: set EMAIL_DEV_LOG=true to print OTP in server console instead
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=gindeberetconstruction278@gmail.com
# SMTP_PASS=your_gmail_app_password
# SMTP_FROM="Gindeberet Admin <gindeberetconstruction278@gmail.com>"
# EMAIL_DEV_LOG=true